# A VPC shared by several clusters. A cluster that owns its network gets one from aws/k8s-cluster instead;
# a cluster living here points at it in its cluster file (vpc.id + vpc.subnet_ids).
# Backend is generated by Atmos (stacks/mixins/aws.yaml)
provider "aws" {
  region = var.region
}
data "aws_availability_zones" "available" {
  # Exclude local zones
  filter {
    name   = "opt-in-status"
    values = ["opt-in-not-required"]
  }
}

locals {
  azs = slice(data.aws_availability_zones.available.names, 0, 3)
}

# Same layout as the VPC inside aws/k8s-cluster
module "vpc" {
  source  = "terraform-aws-modules/vpc/aws"
  version = "~> 5.0"

  name = var.name
  cidr = var.cidr

  # Adopting the default SG / route table / NACL of an existing VPC wipes their rules and routes
  manage_default_security_group = var.manage_defaults
  manage_default_route_table    = var.manage_defaults
  manage_default_network_acl    = var.manage_defaults

  azs             = local.azs
  private_subnets = [for k, v in local.azs : cidrsubnet(var.cidr, 4, k)]
  public_subnets  = [for k, v in local.azs : cidrsubnet(var.cidr, 8, k + 48)]
  intra_subnets   = [for k, v in local.azs : cidrsubnet(var.cidr, 8, k + 52)]

  enable_nat_gateway = true
  single_nat_gateway = true

  public_subnet_tags = merge({
    "kubernetes.io/role/elb" = 1
  }, var.subnet_tags)

  private_subnet_tags = merge({
    "kubernetes.io/role/internal-elb" = 1
  }, var.subnet_tags)

  tags = var.tags
}
