# .Values = component vars from the stack (stacks/catalog/argocd.yaml), passed by Atmos as a state-values file
repositories:
  - name: argo
    url: https://argoproj.github.io/argo-helm

releases:
  - name: argocd
    namespace: {{ .Values.namespace }}
    createNamespace: true
    chart: argo/argo-cd
    version: {{ .Values.chart_version | quote }}
    wait: true
    values:
      - {{ .Values.values | toYaml | nindent 8 }}
{{- with env "ARGOCD_ADMIN_PASSWORD" }}
      # Admin password from env (bcrypt); without it ArgoCD generates argocd-initial-admin-secret
      - configs:
          secret:
            argocdServerAdminPassword: {{ htpasswd "admin" . | trimPrefix "admin:" | quote }}
            # Fixed, otherwise the chart stamps `now` and every apply logs all sessions out
            argocdServerAdminPasswordMtime: "2026-01-01T00:00:00Z"
{{- end }}
